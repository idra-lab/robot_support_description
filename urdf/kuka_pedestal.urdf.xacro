<?xml version="1.0"?>

<robot name="kuka_pedestal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="world"/>

  <xacro:include filename="$(find robot_support_description)/urdf/kuka_pedestal_description.urdf.xacro" />
  <!-- <xacro:include filename="$(find lbr_description)/urdf/iiwa14/iiwa14.xacro" /> -->

  <!-- Instantiate the pedestal -->
  <xacro:kuka_pedestal parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kuka_pedestal>

</robot>